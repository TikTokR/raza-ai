<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talk to your RAZA backend. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Know whether the phone is really online, so the app never pretends cloud AI works offline. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Voice commands and the wake phrase. Requested only when you use them. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android requires these two for a foreground service that uses the microphone. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Show the "microphone is on" notification on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the Clock app open with an alarm filled in (you still confirm it there). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- After a restart or update, post an honest "listening is off, tap to turn on" notice (it cannot start the microphone by itself). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional: lets you ask Android to exempt RAZA from battery optimisation so the listener is ended less often. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Optional: place a call directly instead of opening the dialer (only if you switch that on in Settings). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Optional: find a contact's number when you say "WhatsApp Ali ...". Read only when you ask. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.google.android.youtube" />
        <!-- Needed to find installed apps when you say "open <app>". -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Needed so Android shows speech recognition to this app on Android 11+. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".RazaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="RAZA AI"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Optional. Off until you enable it in Android Settings > Accessibility. Limited to WhatsApp, YouTube and TikTok windows. -->
        <service
            android:name=".RazaAccessibilityService"
            android:exported="true"
            android:label="RAZA AI"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/raza_accessibility" />
        </service>

        <service
            android:name=".WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
