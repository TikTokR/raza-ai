# Copy to your host's environment settings. NEVER commit real values.
NODE_ENV=production
PORT=8080
# Comma-separated "token:role". Tokens need >= 16 chars. role = user | admin.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
RAZA_API_TOKENS=replace-with-long-random-token:user,replace-with-another-long-token:admin
# AI provider key stays on the server only.
ANTHROPIC_API_KEY=
RAZA_MODEL=claude-sonnet-5-5
PROVIDER_TIMEOUT_MS=20000
RATE_LIMIT_PER_MIN=30
